<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Debtly.SettingsPage"
    BackgroundColor="{AppThemeBinding Light=#F5F5F7, Dark=#17212B}">

    <ScrollView>

        <VerticalStackLayout
            Padding="24,60,24,30"
            Spacing="24">

            <Label
                Text="Settings"
                FontSize="34"
                FontAttributes="Bold"
                TextColor="{AppThemeBinding Light=#1C1C1E, Dark=#FFFFFF}" />

            <!-- Preferences -->

            <VerticalStackLayout Spacing="10">

                <Label
                    Text="Preferences"
                    FontSize="14"
                    FontAttributes="Bold"
                    TextColor="{AppThemeBinding Light=#8E8E93, Dark=#8C9BA8}"
                    Margin="4,0,0,0" />

                <Border
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#202B36}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 18"
                    Padding="18">

                    <VerticalStackLayout Spacing="18">

                        <!-- Currency -->

                        <Grid
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="15">

                            <VerticalStackLayout
                                Spacing="3"
                                VerticalOptions="Center">

                                <Label
                                    Text="Currency"
                                    FontSize="17"
                                    TextColor="{AppThemeBinding Light=#1C1C1E, Dark=#FFFFFF}" />

                                <Label
                                    Text="Used throughout the app"
                                    FontSize="13"
                                    TextColor="{AppThemeBinding Light=#8E8E93, Dark=#8C9BA8}" />

                            </VerticalStackLayout>

                            <Picker
                                Grid.Column="1"
                                x:Name="CurrencyPicker"
                                FontSize="16"
                                TextColor="#007AFF"
                                HorizontalOptions="End"
                                VerticalOptions="Center"
                                SelectedIndexChanged="CurrencyPicker_SelectedIndexChanged">

                                <Picker.Items>

                                    <x:String>₪ ILS</x:String>
                                    <x:String>$ USD</x:String>
                                    <x:String>€ EUR</x:String>
                                    <x:String>£ GBP</x:String>
                                    <x:String>₽ RUB</x:String>

                                </Picker.Items>

                            </Picker>

                        </Grid>

                        <BoxView
                            HeightRequest="1"
                            BackgroundColor="{AppThemeBinding Light=#E5E5EA, Dark=#2B3945}" />

                        <!-- Appearance -->

                        <Grid
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="15">

                            <VerticalStackLayout
                                Spacing="3"
                                VerticalOptions="Center">

                                <Label
                                    Text="Appearance"
                                    FontSize="17"
                                    TextColor="{AppThemeBinding Light=#1C1C1E, Dark=#FFFFFF}" />

                                <Label
                                    Text="Choose how Debtly looks"
                                    FontSize="13"
                                    TextColor="{AppThemeBinding Light=#8E8E93, Dark=#8C9BA8}" />

                            </VerticalStackLayout>

                            <Picker
                                Grid.Column="1"
                                x:Name="AppearancePicker"
                                FontSize="16"
                                TextColor="#007AFF"
                                HorizontalOptions="End"
                                VerticalOptions="Center"
                                SelectedIndexChanged="AppearancePicker_SelectedIndexChanged">

                                <Picker.Items>

                                    <x:String>System</x:String>
                                    <x:String>Light</x:String>
                                    <x:String>Dark</x:String>

                                </Picker.Items>

                            </Picker>

                        </Grid>

                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>

            <!-- Data -->

            <VerticalStackLayout Spacing="10">

                <Label
                    Text="Data"
                    FontSize="14"
                    FontAttributes="Bold"
                    TextColor="{AppThemeBinding Light=#8E8E93, Dark=#8C9BA8}"
                    Margin="4,0,0,0" />

                <Border
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#202B36}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 18"
                    Padding="18">

                    <VerticalStackLayout Spacing="16">

                        <Grid
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="15">

                            <VerticalStackLayout
                                Spacing="3"
                                VerticalOptions="Center">

                                <Label
                                    Text="Export Data"
                                    FontSize="17"
                                    TextColor="{AppThemeBinding Light=#1C1C1E, Dark=#FFFFFF}" />

                                <Label
                                    Text="Save your people and transactions"
                                    FontSize="13"
                                    TextColor="{AppThemeBinding Light=#8E8E93, Dark=#8C9BA8}" />

                            </VerticalStackLayout>

                            <Button
                                Grid.Column="1"
                                Text="Export"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="#007AFF"
                                BackgroundColor="{AppThemeBinding Light=#E5F1FF, Dark=#1E3A5F}"
                                CornerRadius="12"
                                Padding="14,8"
                                VerticalOptions="Center"
                                Clicked="OnExportDataClicked" />

                        </Grid>

                        <BoxView
                            HeightRequest="1"
                            BackgroundColor="{AppThemeBinding Light=#E5E5EA, Dark=#2B3945}" />

                        <Grid
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="15">

                            <VerticalStackLayout
                                Spacing="3"
                                VerticalOptions="Center">

                                <Label
                                    Text="Delete All Data"
                                    FontSize="17"
                                    TextColor="#FF453A" />

                                <Label
                                    Text="Delete all people and transactions"
                                    FontSize="13"
                                    TextColor="{AppThemeBinding Light=#8E8E93, Dark=#8C9BA8}" />

                            </VerticalStackLayout>

                            <Button
                                Grid.Column="1"
                                Text="Delete"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="#FF453A"
                                BackgroundColor="{AppThemeBinding Light=#FFE5E3, Dark=#4A2928}"
                                CornerRadius="12"
                                Padding="14,8"
                                VerticalOptions="Center"
                                Clicked="OnDeleteAllDataClicked" />

                        </Grid>

                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>

            <!-- About -->

            <VerticalStackLayout Spacing="10">

                <Label
                    Text="About"
                    FontSize="14"
                    FontAttributes="Bold"
                    TextColor="{AppThemeBinding Light=#8E8E93, Dark=#8C9BA8}"
                    Margin="4,0,0,0" />

                <Border
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#202B36}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 18"
                    Padding="18">

                    <Grid
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="15">

                        <VerticalStackLayout
                            Spacing="3"
                            VerticalOptions="Center">

                            <Label
                                Text="Debtly"
                                FontSize="17"
                                FontAttributes="Bold"
                                TextColor="{AppThemeBinding Light=#1C1C1E, Dark=#FFFFFF}" />

                            <Label
                                Text="Personal money tracker"
                                FontSize="13"
                                TextColor="{AppThemeBinding Light=#8E8E93, Dark=#8C9BA8}" />

                        </VerticalStackLayout>

                        <Label
                            Grid.Column="1"
                            Text="Version 1.0"
                            FontSize="14"
                            TextColor="{AppThemeBinding Light=#8E8E93, Dark=#8C9BA8}"
                            VerticalOptions="Center" />

                    </Grid>

                </Border>

            </VerticalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>